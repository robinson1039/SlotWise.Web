@using SlotWise.Web.Core.Pagination
@using SlotWise.Web.DTOs
@model List<SlotWise.Web.DTOs.ReservationDTO>
@inject SlotWise.Web.Services.Abstractions.IUserService _userService

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@{
    ViewData["Title"] = "Reservas";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Reservas</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">

        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">Reservas</h3>
                @if (await _userService.CurrentUserIsAuthorizedAsync("createReservations", "Reservacion"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body mt-3">

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre usuario</th>
                        <th>Nombre del especialista</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserName</td>
                            <td>@item.SpecialistName</td>
                            <td>@item.ServiceName</td>
                            <td>
                                @if (item.Status)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@item.CreateAt</td>
                            <td>
                                @* Solo muestra los botones si el usuario tiene permiso *@
                                @if (await _userService.CurrentUserIsAuthorizedAsync("updateReservations", "Reservacion"))
                                {
                                    <a asp-action="Edit" asp-route-Id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <form asp-action="Toggle" style="display: contents;" method="POST">
                                        <input type="hidden" value="@item.Id" name="Id" />
                                        <input type="hidden" value="@(!item.Status)" name="Status" />
                                        <button class="btn btn-sm @(item.Status ? "btn-secondary" : "btn-info")"
                                                data-bs-toggle="tooltip" data-bs-placement="top"
                                                title="@(item.Status ? "Desactivar" : "Activar")">
                                            <i class="@(item.Status ? "bi bi-eye-slash-fill" : "bi bi-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-Id="@item.Id" style="display: contents;">
                                        <button class="btn btn-sm btn-danger btnDelete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btnDelete').click(function (event) {
                event.preventDefault();
                Swal.fire({
                    icon: "question",
                    title: "¿Desea eliminar el servicio?",
                    text: "No podrá revertirlo",
                    showCancelButton: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });
        });
    </script>
}