@{
    ViewData["Title"] = "Mis Permisos";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-check"></i> Mis Permisos y Roles
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Información del Usuario -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>👤 Información del Usuario</h5>
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <strong>Nombre:</strong> @Model.FullName
                                </li>
                                <li class="list-group-item">
                                    <strong>Email:</strong> @Model.Email
                                </li>
                                <li class="list-group-item">
                                    <strong>ID:</strong> <small class="text-muted">@Model.UserId</small>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Roles de Identity -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5>🔐 Roles de Identity</h5>
                            @if (Model.IdentityRoles.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var role in Model.IdentityRoles)
                                    {
                                        <span class="badge bg-success fs-6">@role</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No tiene roles de Identity asignados</p>
                            }
                        </div>
                    </div>

                    <!-- Rol Personalizado -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5>🎯 Rol Personalizado</h5>
                            @if (Model.PrivateRole != null)
                            {
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">@Model.PrivateRole.Name</h6>
                                        <!-- Solo nombre, PrivateRole NO tiene Description -->
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No tiene rol personalizado asignado</p>
                            }
                        </div>
                    </div>

                    <!-- Permisos Personalizados -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5>📋 Permisos Personalizados</h5>
                            @if (Model.CustomPermissions.Count > 0)
                            {
                                <div class="row">
                                    @foreach (var permission in Model.CustomPermissions)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="card border-success">
                                                <div class="card-body py-2">
                                                    <h6 class="card-title mb-1">
                                                        <i class="bi bi-check-circle-fill text-success"></i>
                                                        @permission.Name
                                                    </h6>
                                                    <!-- Permission SÍ tiene Description -->
                                                    <p class="card-text small text-muted mb-0">@permission.Description</p>
                                                    <small class="text-info">Módulo: @permission.Module</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Total: @Model.CustomPermissions.Count permisos</small>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No tiene permisos personalizados</p>
                            }
                        </div>
                    </div>

                    <!-- Claims -->
                    <div class="row">
                        <div class="col-12">
                            <h5>🏷️ Claims de Identity</h5>
                            @if (Model.IdentityClaims.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Tipo</th>
                                                <th>Valor</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var claim in Model.IdentityClaims)
                                            {
                                                <tr>
                                                    <td><code>@claim.Type</code></td>
                                                    <td>@claim.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No tiene claims</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted">
                    <small>Los permisos también se han mostrado en la consola del servidor</small>
                </div>
            </div>
        </div>
    </div>
</div>