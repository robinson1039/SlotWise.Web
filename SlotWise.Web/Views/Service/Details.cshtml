@model SlotWise.Web.DTOs.ServiceDTO

@{
    ViewData["Title"] = "Detalle del servicio";
}

<div class="pagetitle">
    <h1>Detalle del servicio</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Service">Servicios</a></li>
            <li class="breadcrumb-item active">@Model.NameService</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card shadow">
        <img src="~/images/@Model.ImgService"
             class="card-img-top"
             style="height: 300px; object-fit: cover;" />

        <div class="card-body">

            <h2 class="card-title">@Model.NameService</h2>

            <p class="card-text mt-3">@Model.Description</p>

            <p class="mt-3">
                <strong>Precio:</strong> $@Model.Price
            </p>

            <hr />

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Reserve"
                   asp-controller="Reservation"
                   asp-route-serviceId="@Model.Id"
                   class="btn btn-success btn-lg">
                    <i class="bi bi-calendar-check"></i> Reservar este servicio
                </a>
            }

            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</section>